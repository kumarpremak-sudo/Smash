rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      // Guests do not have an email or user document, so return null
      return request.auth.token.firebase.sign_in_provider == 'anonymous' ? null : 
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && !isGuest() && (
        (getUserData() != null && getUserData().role == 'SUPER_ADMIN') || 
        (request.auth.token.email == 'kumarprem.ak@gmail.com')
      );
    }
    
    function isGuest() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasAcademyAccess(targetAcademyId) {
      return isAuthenticated() && (
        (isGuest() && targetAcademyId == 'demo_' + request.auth.uid) ||
        (!isGuest() && getUserData() != null && (
          getUserData().academyId == targetAcademyId || 
          (getUserData().academyRoles != null && targetAcademyId in getUserData().academyRoles)
        ))
      );
    }

    function isTenantAdmin(targetAcademyId) {
      return hasAcademyAccess(targetAcademyId) && (
        isGuest() || (getUserData() != null && getUserData().role == 'TENANT_ADMIN')
      );
    }

    // --- Rules ---



    // 2. Users (RBAC)
    match /users/{userEmail} {
      // Allow read for any authenticated non-guest user
      allow read: if isAuthenticated() && !isGuest();
      
      // Super admins can create users. Tenant Admins can create non-super admins.
      allow create: if isSuperAdmin() || (
        (!isGuest() && getUserData().role == 'TENANT_ADMIN') && 
        request.resource.data.role != 'SUPER_ADMIN'
      );
      
      // Tenant Admins can update any non-super admin (to allow adding them to multiple academies)
      allow update: if isSuperAdmin() || (
        (!isGuest() && getUserData().role == 'TENANT_ADMIN') && 
        resource.data.role != 'SUPER_ADMIN' && 
        request.resource.data.role != 'SUPER_ADMIN'
      );
      
      // Only Super Admins or the Tenant Admin of the user's primary academy can delete
      allow delete: if isSuperAdmin() || (
        (!isGuest() && getUserData().role == 'TENANT_ADMIN') &&
        resource.data.academyId == getUserData().academyId
      );
    }

    // 3. Tenant Data Collections (Bookings, Members, Configs, Courts, Academies, etc.)
    match /academies/{academyId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(academyId);
      allow create, delete: if isSuperAdmin() || isTenantAdmin(academyId);
      allow update: if isSuperAdmin() || isTenantAdmin(academyId) || (
        hasAcademyAccess(academyId) && 
        resource.data.get('allow_staff_program_edit', false) == true &&
        request.resource.data.get('allow_staff_program_edit', false) == true
      );
    }
    
    match /bookings/{bookingId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow create: if isSuperAdmin() || hasAcademyAccess(request.resource.data.get('academyId', ''));
      allow update, delete: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
    }
    
    match /members/{memberId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow create: if isSuperAdmin() || hasAcademyAccess(request.resource.data.get('academyId', ''));
      allow update, delete: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
    }

    match /enquiries/{enquiryId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow create: if isSuperAdmin() || hasAcademyAccess(request.resource.data.get('academyId', ''));
      allow update, delete: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
    }

    match /configs/{configId} {
      allow read: if configId == 'auth' || isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow write: if isSuperAdmin() || isTenantAdmin(resource.data.get('academyId', '')) || isTenantAdmin(request.resource.data.get('academyId', '')) || (
        hasAcademyAccess(resource.data.get('academyId', '')) &&
        get(/databases/$(database)/documents/academies/$(resource.data.get('academyId', ''))).data.get('allow_staff_program_edit', false) == true
      );
    }

    match /courts/{courtId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow write: if isSuperAdmin() || isTenantAdmin(resource.data.get('academyId', '')) || isTenantAdmin(request.resource.data.get('academyId', '')) || (
        hasAcademyAccess(resource.data.get('academyId', '')) &&
        get(/databases/$(database)/documents/academies/$(resource.data.get('academyId', ''))).data.get('allow_staff_program_edit', false) == true
      );
    }
    
    match /programs/{programId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow write: if isSuperAdmin() || isTenantAdmin(resource.data.get('academyId', '')) || isTenantAdmin(request.resource.data.get('academyId', '')) || (
        hasAcademyAccess(resource.data.get('academyId', '')) &&
        get(/databases/$(database)/documents/academies/$(resource.data.get('academyId', ''))).data.get('allow_staff_program_edit', false) == true
      );
    }
    
    match /coaching/{coachingId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow write: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', '')) || hasAcademyAccess(request.resource.data.get('academyId', ''));
    }

    match /hourly_slots/{slotId} {
      allow read: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
      allow write: if isSuperAdmin() || isTenantAdmin(resource.data.get('academyId', '')) || isTenantAdmin(request.resource.data.get('academyId', '')) || (
        hasAcademyAccess(resource.data.get('academyId', '')) &&
        get(/databases/$(database)/documents/academies/$(resource.data.get('academyId', ''))).data.get('allow_staff_program_edit', false) == true
      );
    }

    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin() || resource == null || hasAcademyAccess(resource.data.get('academyId', ''));
      allow create: if isSuperAdmin() || hasAcademyAccess(request.resource.data.get('academyId', ''));
      allow update, delete: if isSuperAdmin() || hasAcademyAccess(resource.data.get('academyId', ''));
    }
  }
}
